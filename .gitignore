# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should only be ignored for special cases (e.g. generated assets)
# *.meta

# Uncomment this line if you prefer to ignore the asset serialization mode set to "Force Text"
# ProjectSettings/AssetSerializationMode.asset

# Visual Studio cache/solution files
[Ee]xtensions/
[Ll]oadedModules/
[Cc]ache/
[Rr]estored/
[Pp]ackages/cache/
[Pp]ackages/lock.json
.vs/
.gradle/
export/

# Autogenerated VS/MonoDevelop/Unity projects
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File Types
*.house
*.asset.meta

# Creature Animation
*.creature

# macOS temporary files
.DS_Store

# JetBrains Rider
.idea/